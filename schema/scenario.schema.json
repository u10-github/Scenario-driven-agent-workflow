{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/u10-github/Scenario-driven-agent-workflow/schema/scenario.schema.json",
  "title": "Scenario-driven agent workflow scenario",
  "description": "A portable workflow blueprint that an AI agent can adapt into project-specific instructions, scripts, evidence formats, and human approval gates.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "name",
    "version",
    "purpose",
    "non_goals",
    "invariants",
    "actors",
    "dependencies",
    "runtime_modes",
    "steps",
    "evidence",
    "human_gates",
    "safety",
    "fallback_policy"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "actors": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "default": {
            "type": "string"
          },
          "aliases": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "responsibilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "$ref": "#/$defs/dependencyList"
        },
        "recommended": {
          "$ref": "#/$defs/dependencyList"
        },
        "optional": {
          "$ref": "#/$defs/dependencyList"
        }
      }
    },
    "install_policy": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "runtime_modes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "description": {
            "type": "string"
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "model_policy": {
      "type": "object",
      "additionalProperties": true
    },
    "state": {
      "type": "object",
      "additionalProperties": true
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["command"],
        "additionalProperties": true,
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "actor"],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "type": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "requires": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "gates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "markers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "human_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "trigger"],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "trigger": {
            "type": "string"
          },
          "required_output": {
            "type": "string"
          },
          "approval_protocol": {
            "$ref": "#/$defs/approvalProtocol"
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "stop_conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "irreversible_operations": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "fallback_policy": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "dependencyList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "check"],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "check": {
            "type": "string"
          },
          "missing": {
            "type": "string",
            "enum": ["stop", "human_required", "warn", "fallback"]
          },
          "fallback": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "description"],
              "additionalProperties": true,
              "properties": {
                "id": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "approvalProtocol": {
      "type": "object",
      "additionalProperties": true,
      "required": ["marker", "required_fields"],
      "properties": {
        "marker": {
          "type": "string",
          "minLength": 1
        },
        "required_fields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "example": {
          "type": "string"
        }
      }
    }
  }
}
